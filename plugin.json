{
    "name": "WaldorfshopSeoTest",
    "namespace": "WaldorfshopSeoTest",
    "type": "theme",
    "version": "0.5.16",
    "license": "AGPL-3.0",
    "isClosedSource": false,
    "description": "SEO templates and optional EUR 0.50 shipping contribution. Climate branch for unlinked test plugin set 428.",
    "author": "Universnatur GmbH",
    "authorIcon": "icon_author_xs.png",
    "pluginIcon": "icon_plugin_xs.png",
    "require": {
        "Ceres": "5.0.84",
        "IO": "5.0.83",
        "Waldorfshop7": "5.0.74"
    },
    "serviceProvider": "WaldorfshopSeoTest\\Providers\\SeoTestServiceProvider",
    "dataProviders": [
        {
            "key": "WaldorfshopSeoTest\\Providers\\ClimateContributionProvider",
            "name": "Freiwilliger Versandbeitrag (0,50 EUR)",
            "description": "Opt-in vor der Bestellsumme.",
            "defaultLayoutContainer": "Ceres::Checkout.BeforeBasketTotals"
        },
        {
            "key": "WaldorfshopSeoTest\\Providers\\ClimateScriptProvider",
            "name": "Versandbeitrag: Checkout-Skript",
            "description": "Synchronisiert den freiwilligen Beitrag mit der serverseitigen Berechnung.",
            "defaultLayoutContainer": "Ceres::Checkout.AfterScriptsLoaded"
        }
    ]
}
