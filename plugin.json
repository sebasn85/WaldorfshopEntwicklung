{
    "name": "WaldorfshopErweiterungen",
    "namespace": "WaldorfshopErweiterungen",
    "type": "theme",
    "version": "0.5.31",
    "license": "AGPL-3.0",
    "isClosedSource": false,
    "description": "Waldorfshop extensions for SEO, checkout localisation and voluntary EUR 0.50 shipping contributions.",
    "author": "Universnatur GmbH",
    "authorIcon": "icon_author_xs.png",
    "pluginIcon": "icon_plugin_xs.png",
    "require": {
        "Ceres": "5.0.86",
        "IO": "5.0.86",
        "Waldorfshop7": "5.0.74"
    },
    "serviceProvider": "WaldorfshopErweiterungen\\Providers\\SeoTestServiceProvider",
    "dataProviders": [
        {
            "key": "WaldorfshopErweiterungen\\Providers\\ClimateContributionProvider",
            "name": "Freiwilliger Versandbeitrag (0,50 EUR)",
            "description": "Opt-in vor der Bestellsumme.",
            "defaultLayoutContainer": "Ceres::Checkout.BeforeBasketTotals"
        },
        {
            "key": "WaldorfshopErweiterungen\\Providers\\ClimateScriptProvider",
            "name": "Versandbeitrag: Checkout-Skript",
            "description": "Synchronisiert den freiwilligen Beitrag mit der serverseitigen Berechnung.",
            "defaultLayoutContainer": "Ceres::Checkout.AfterScriptsLoaded"
        }
    ]
}
