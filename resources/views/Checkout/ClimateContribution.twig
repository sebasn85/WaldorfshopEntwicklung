    data-ws-climate-selected="{{ (trans('WaldorfshopSeoTest::Template.climateSelected') == 'WaldorfshopSeoTest::Template.climateSelected' ? climateCopy.climateSelected : trans('WaldorfshopSeoTest::Template.climateSelected')) | escape('html_attr') }}"
