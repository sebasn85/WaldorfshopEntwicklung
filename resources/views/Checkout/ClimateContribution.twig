    data-ws-climate-reload="{{ (trans('WaldorfshopSeoTest::Template.climateReload') == 'WaldorfshopSeoTest::Template.climateReload' ? climateCopy.climateReload : trans('WaldorfshopSeoTest::Template.climateReload')) | escape('html_attr') }}"
    data-ws-climate-save-failed="{{ (trans('WaldorfshopSeoTest::Template.climateSaveFailed') == 'WaldorfshopSeoTest::Template.climateSaveFailed' ? climateCopy.climateSaveFailed : trans('WaldorfshopSeoTest::Template.climateSaveFailed')) | escape('html_attr') }}"
