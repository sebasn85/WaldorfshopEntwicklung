    <label class="d-flex align-items-start mb-2" style="gap:.65rem;cursor:pointer">
        <input type="checkbox" data-ws-climate-checkbox disabled style="margin-top:.3rem;flex-shrink:0" aria-describedby="ws-climate-explanation ws-climate-status">
        <strong>{{ (trans('WaldorfshopSeoTest::Template.climateSupportLabel') == 'WaldorfshopSeoTest::Template.climateSupportLabel' ? climateCopy.climateSupportLabel : trans('WaldorfshopSeoTest::Template.climateSupportLabel')) }}</strong>
    </label>
    <p id="ws-climate-explanation" class="small mb-2">{{ (trans('WaldorfshopSeoTest::Template.climateSupportExplanation') == 'WaldorfshopSeoTest::Template.climateSupportExplanation' ? climateCopy.climateSupportExplanation : trans('WaldorfshopSeoTest::Template.climateSupportExplanation')) }} <strong>{{ (trans('WaldorfshopSeoTest::Template.climateSupportReassurance') == 'WaldorfshopSeoTest::Template.climateSupportReassurance' ? climateCopy.climateSupportReassurance : trans('WaldorfshopSeoTest::Template.climateSupportReassurance')) }}</strong></p>
